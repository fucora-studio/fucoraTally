{
	"name": "tally",
	"version": "0.6.0",
	"private": true,
	"packageManager": "pnpm@12.3.4",
	"dependencies": {
		"@vinext/cloudflare": "latest",
		"cheerio": "^1.2.0",
		"playwright": "^1.63.0",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"vinext": "latest",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "latest",
		"@tailwindcss/postcss": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "latest",
